{
  "name": "p4english",
  "compatibility_date": "2026-10-28",
  "main": "src/worker.js",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "05aca8f2017946c19cc94c2149eddb2d"
    }
  ]
}
